{
    "key": "group_sidebar_menu",
    "title": "Sidebar Menu Configuration",
    "fields": [
        {
            "key": "field_sidebar_menu_items",
            "label": "Menu Items",
            "name": "sidebar_menu_items",
            "type": "repeater",
            "instructions": "Configure the sidebar menu items for this page",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "collapsed": "field_menu_item_title",
            "min": 0,
            "max": 0,
            "layout": "table",
            "button_label": "Add Menu Item",
            "sub_fields": [
                {
                    "key": "field_menu_item",
                    "label": "Menu Item",
                    "name": "menu_item",
                    "type": "group",
                    "instructions": "",
                    "required": 0,
                    "conditional_logic": 0,
                    "wrapper": {
                        "width": "",
                        "class": "",
                        "id": ""
                    },
                    "layout": "block",
                    "sub_fields": [
                        {
                            "key": "field_menu_type",
                            "label": "Menu Type",
                            "name": "menu_type",
                            "type": "select",
                            "instructions": "Choose the type of menu item",
                            "required": 1,
                            "conditional_logic": 0,
                            "wrapper": {
                                "width": "50",
                                "class": "",
                                "id": ""
                            },
                            "choices": {
                                "ma_bibliotheque": "Ma Bibliothèque",
                                "ma_collection": "Ma Collection",
                                "mes_souhaits": "Mes Souhaits",
                                "mes_albums_manquants": "Mes Albums Manquants",
                                "page": "Page Link",
                                "custom": "Custom Link"
                            },
                            "default_value": "ma_bibliotheque",
                            "allow_null": 0,
                            "multiple": 0,
                            "ui": 0,
                            "return_format": "value",
                            "ajax": 0,
                            "placeholder": ""
                        },
                        {
                            "key": "field_custom_title",
                            "label": "Custom Title",
                            "name": "custom_title",
                            "type": "text",
                            "instructions": "Override the default title (optional)",
                            "required": 0,
                            "conditional_logic": 0,
                            "wrapper": {
                                "width": "50",
                                "class": "",
                                "id": ""
                            },
                            "default_value": "",
                            "placeholder": "",
                            "prepend": "",
                            "append": "",
                            "maxlength": ""
                        },
                        {
                            "key": "field_page_link",
                            "label": "Page",
                            "name": "page_link",
                            "type": "post_object",
                            "instructions": "Select a page to link to",
                            "required": 1,
                            "conditional_logic": [
                                [
                                    {
                                        "field": "field_menu_type",
                                        "operator": "==",
                                        "value": "page"
                                    }
                                ]
                            ],
                            "wrapper": {
                                "width": "50",
                                "class": "",
                                "id": ""
                            },
                            "post_type": [
                                "page"
                            ],
                            "taxonomy": "",
                            "allow_null": 0,
                            "multiple": 0,
                            "return_format": "object",
                            "ui": 1
                        },
                        {
                            "key": "field_custom_url",
                            "label": "Custom URL",
                            "name": "custom_url",
                            "type": "url",
                            "instructions": "Enter a custom URL",
                            "required": 1,
                            "conditional_logic": [
                                [
                                    {
                                        "field": "field_menu_type",
                                        "operator": "==",
                                        "value": "custom"
                                    }
                                ]
                            ],
                            "wrapper": {
                                "width": "50",
                                "class": "",
                                "id": ""
                            },
                            "default_value": "",
                            "placeholder": "https://example.com"
                        },
                        {
                            "key": "field_custom_icon",
                            "label": "Custom Icon",
                            "name": "custom_icon",
                            "type": "text",
                            "instructions": "Enter a Dashicons class name (e.g., dashicons-admin-home)",
                            "required": 0,
                            "conditional_logic": [
                                [
                                    {
                                        "field": "field_menu_type",
                                        "operator": "==",
                                        "value": "page"
                                    }
                                ],
                                [
                                    {
                                        "field": "field_menu_type",
                                        "operator": "==",
                                        "value": "custom"
                                    }
                                ]
                            ],
                            "wrapper": {
                                "width": "50",
                                "class": "",
                                "id": ""
                            },
                            "default_value": "",
                            "placeholder": "dashicons-admin-home",
                            "prepend": "",
                            "append": "",
                            "maxlength": ""
                        }
                    ]
                }
            ]
        },
        {
            "key": "field_page_subtitle",
            "label": "Page Subtitle",
            "name": "page_subtitle",
            "type": "text",
            "instructions": "Optional subtitle to display below the page title",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "",
            "placeholder": "Enter a subtitle for this page",
            "prepend": "",
            "append": "",
            "maxlength": ""
        }
    ],
    "location": [
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-with-sidebar.php"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "Configure the sidebar menu for pages using the 'Page with Sidebar' template"
}
